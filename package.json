{
  "name": "corp-portal",
  "version": "1.4.11",
  "private": true,
  "description": "企业门户 · 快捷导航（服务端存储，支持内外网双地址自动切换）",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:web": "node scripts/launch.mjs web",
    "start:desktop": "node scripts/launch.mjs desktop",
    "start:both": "node scripts/launch.mjs both",
    "icon": "node scripts/make-icon.mjs",
    "release": "node scripts/release.mjs",
    "desktop": "npm --prefix desktop start",
    "desktop:dev": "npm --prefix desktop run start:dev",
    "build:desktop": "node scripts/build-desktop.mjs",
    "start:client": "node scripts/launch.mjs client"
  },
  "engines": {
    "node": ">=16"
  }
}
