{
  "name": "portal-desktop",
  "version": "1.4.12",
  "private": true,
  "description": "企业服务大厅 · 桌面客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron . --dev",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "cn.szwl.portal",
    "productName": "企业服务大厅",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "setup.html",
      "host-preload.js",
      "guest-preload.js",
      "dl-tip-preload.js",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "企业服务大厅",
      "artifactName": "portal-setup-${version}.exe"
    },
    "portable": {
      "artifactName": "portal-portable-${version}.exe"
    }
  }
}
